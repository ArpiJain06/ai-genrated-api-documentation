generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Upload {
  id           String        @id @default(uuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  createdAt    DateTime      @default(now())
  status       UploadStatus  @default(PENDING)
  s3Url        String?
  parsed       Json?
  version      Int           @default(1)
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}